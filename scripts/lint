#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 "$ROOT/scripts/registry.py" validate

python3 - "$ROOT" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
errors = []

for p in root.rglob("*"):
    if not p.is_file():
        continue
    if ".git" in p.parts:
        continue
    if p.suffix in {".png", ".jpg", ".jpeg", ".gif", ".zip"}:
        continue
    try:
        data = p.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    if data and not data.endswith("\n"):
        errors.append(f"{p.relative_to(root)}: missing final newline")
    for i, line in enumerate(data.splitlines(), start=1):
        if line.endswith((" ", "\t")):
            errors.append(f"{p.relative_to(root)}:{i}: trailing whitespace")

if errors:
    for e in errors:
        print(f"ERROR: {e}", file=sys.stderr)
    raise SystemExit(1)

print("Text lint: PASS")
PY

for script in "$ROOT"/scripts/*; do
  [[ -f "$script" ]] || continue
  first_line="$(head -n 1 "$script" 2>/dev/null || true)"
  case "$first_line" in
    *bash*|*sh)
      bash -n "$script"
      ;;
    *python*)
      python3 -m py_compile "$script"
      ;;
  esac
done

echo "Script syntax: PASS"
